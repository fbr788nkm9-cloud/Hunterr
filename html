<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Game HUD Mockup</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: linear-gradient(180deg, #0d1b2a 0%, #111827 100%);
      color: white;
      overflow: hidden;
    }

    .game-screen {
      position: relative;
      width: 100vw;
      height: 100vh;
      background:
        radial-gradient(circle at center, rgba(255,255,255,0.05), rgba(0,0,0,0.1) 35%, rgba(0,0,0,0.7)),
        linear-gradient(180deg, #1b263b 0%, #0b1220 100%);
      overflow: hidden;
    }

    .crosshair {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 36px;
      height: 36px;
      border: 2px solid rgba(255,255,255,0.8);
      border-radius: 50%;
      opacity: 0.8;
    }

    .crosshair::before,
    .crosshair::after {
      content: "";
      position: absolute;
      background: rgba(255,255,255,0.8);
    }

    .crosshair::before {
      left: 50%;
      top: -9px;
      width: 2px;
      height: 54px;
      transform: translateX(-50%);
    }

    .crosshair::after {
      top: 50%;
      left: -9px;
      width: 54px;
      height: 2px;
      transform: translateY(-50%);
    }

    .top-bar {
      position: absolute;
      top: 20px;
      left: 20px;
      right: 20px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    .left-panel {
      display: flex;
      gap: 18px;
      align-items: center;
    }

    .health-box, .ammo-box, .mini-box {
      background: rgba(10, 16, 24, 0.55);
      border: 1px solid rgba(255,255,255,0.15);
      box-shadow: inset 0 0 10px rgba(255,255,255,0.05);
      backdrop-filter: blur(3px);
    }

    .health-box {
      width: 220px;
      padding: 10px 12px;
      border-radius: 12px;
    }

    .label {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #bfd7ff;
      margin-bottom: 7px;
      opacity: 0.9;
    }

    .bar {
      height: 12px;
      background: rgba(255,255,255,0.08);
      border-radius: 999px;
      overflow: hidden;
      position: relative;
    }

    .bar-fill {
      position: absolute;
      inset: 0 auto 0 0;
      width: 82%;
      border-radius: inherit;
      background: linear-gradient(90deg, #ff5d5d, #ffb347, #ffe066);
    }

    .ammo-box {
      padding: 10px 14px;
      border-radius: 12px;
      min-width: 100px;
      text-align: center;
    }

    .ammo-box .num {
      font-size: 34px;
      font-weight: 700;
      color: #fff;
    }

    .ammo-box .sub {
      font-size: 11px;
      letter-spacing: 2px;
      color: #b8d0ff;
    }

    .right-panel {
      display: flex;
      gap: 16px;
      align-items: center;
    }

    .mini-box {
      width: 130px;
      height: 90px;
      border-radius: 14px;
      position: relative;
      overflow: hidden;
      background:
        linear-gradient(135deg, rgba(40,60,80,0.9), rgba(10,20,35,0.85)),
        repeating-linear-gradient(
            0deg,
            rgba(120,200,255,0.2), rgba(120,200,255,0.2) 1px, transparent 1px, transparent 3px
        );
    }

    .mini-box::before {
      content: "";
      position: absolute;
      inset: 10px;
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 50%;
      box-shadow: inset 0 0 30px rgba(116,213,255,0.15);
    }

    .mini-box::after {
      content: "";
      position: absolute;
      width: 12px;
      height: 12px;
      background: #72f1b8;
      border-radius: 50%;
      top: 34px;
      left: 62px;
      box-shadow: 0 0 10px #72f1b8;
    }

    .score-box {
      min-width: 150px;
      background: rgba(10,16,24,0.55);
      border: 1px solid rgba(255,255,255,0.15);
      padding: 10px 12px;
      border-radius: 12px;
      text-align: right;
    }

    .score-box .title {
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #bfe9ff;
    }

    .score-box .value {
      font-size: 28px;
      font-weight: 700;
      margin-top: 4px;
    }

    .bottom-bar {
      position: absolute;
      left: 30px;
      right: 30px;
      bottom: 24px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }

    .left-skills {
      display: flex;
      gap: 12px;
    }

    .skill {
      width: 72px;
      height: 72px;
      border-radius: 14px;
      background: rgba(10, 16, 24, 0.6);
      border: 1px solid rgba(255,255,255,0.18);
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      font-weight: 700;
      color: #d8eeff;
      box-shadow: inset 0 0 14px rgba(255,255,255,0.04);
    }

    .skill::before {
      content: "";
      position: absolute;
      inset: 8px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.08);
    }

    .skill.hotkey {
      color: #ffee96;
    }

    .right-status {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .status-pill {
      padding: 10px 14px;
      border-radius: 999px;
      background: rgba(12,20,28,0.6);
      border: 1px solid rgba(255,255,255,0.18);
      color: #dff5ff;
      font-size: 12px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .status-pill strong {
      color: #7ef0c4;
    }

    .mission-box {
      position: absolute;
      right: 30px;
      top: 120px;
      width: 240px;
      background: rgba(7, 17, 24, 0.58);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 14px;
      padding: 14px 14px 12px;
      backdrop-filter: blur(3px);
    }

    .mission-box .title {
      font-size: 11px;
      letter-spacing: 2px;
      color: #bbddff;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .mission-box .task {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .mission-box .detail {
      color: rgba(255,255,255,0.72);
      font-size: 13px;
      line-height: 1.5;
    }

    .damage-flash {
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(255,48,48,0.18), rgba(255,80,80,0.05), rgba(255,0,0,0.2));
      opacity: 0.45;
      mix-blend-mode: screen;
      pointer-events: none;
    }

    @media (max-width: 700px) {
      .top-bar { gap: 10px; }
      .left-panel, .right-panel { gap: 10px; }
      .health-box { width: 160px; }
      .score-box { display: none; }
      .mission-box { width: 180px; }
      .skill { width: 58px; height: 58px; }
    }
  </style>
</head>
<body>
  <div class="game-screen">
    <div class="crosshair"></div>

    <div class="top-bar">
      <div class="left-panel">
        <div class="health-box">
          <div class="label">
            <span>HP</span>
            <span>82%</span>
          </div>
          <div class="bar">
            <div class="bar-fill"></div>
          </div>
        </div>

        <div class="ammo-box">
          <div class="num">24</div>
          <div class="sub">AMMO</div>
        </div>
      </div>

      <div class="right-panel">
        <div class="mini-box"></div>
        <div class="score-box">
          <div class="title">Score</div>
          <div class="value">12850</div>
        </div>
      </div>
    </div>

    <div class="mission-box">
      <div class="title">Mission</div>
      <div class="task">Hold the zone</div>
      <div class="detail">
        Defend the checkpoint and eliminate enemies in the north sector.
      </div>
    </div>

    <div class="bottom-bar">
      <div class="left-skills">
        <div class="skill hotkey">Q</div>
        <div class="skill">E</div>
        <div class="skill">R</div>
      </div>

      <div class="right-status">
        <div class="status-pill"><strong>LIVE</strong> 03:42</div>
        <div class="status-pill">Squad 4</div>
      </div>
    </div>

    <div class="damage-flash"></div>
  </div>

  <script>
    const healthFill = document.querySelector('.bar-fill');
    let hp = 82;

    setInterval(() => {
      hp = hp <= 10 ? 82 : hp - 1;
      healthFill.style.width = hp + '%';
      document.querySelector('.health-box .label span:last-child').textContent = hp + '%';
    }, 1800);
  </script>
</body>
</html>